NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=/app/data/database.sqlite
BACKUP_PATH=/app/backups
STATIC_ROOT=/app/data/web
STATIC_SOURCE_PATH=/app/frontend/dist
PUBLIC_ORIGIN=https://www.anothergamemore.online
COOKIE_SECURE=auto

SESSION_SECRET=
PASSWORD_PEPPER=
MOBILE_ACCESS_TOKEN_SECRET=
MOBILE_REFRESH_TOKEN_SECRET=

DONATION_SECRET=
ITEMS_SECRET=
STATS_SECRET=
BOMBGAME_SECRET=
DONATION_WEBHOOK=
SINGLE_ITEM_WEBHOOK=
BULK_ITEMS_WEBHOOK=
STATS_WEBHOOK=
REQUIRE_SIGNED_WEBHOOKS=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

DOCKER_ENABLED=false
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_ALLOWED_CONTAINERS=
# Numeric GID of the host's agmapp group when optional socket helpers are enabled.
AGM_SOCKET_GID=1000
NGINX_ENABLED=false
HOST_CONTROL_ENABLED=false
HOST_CONTROL_SOCKET=/run/agm-host-control.sock
HOST_CONTROL_SECRET=

BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_RETENTION=14
REQUEST_LOG_RETENTION_DAYS=30
ALERT_CPU_PERCENT=0
ALERT_RAM_PERCENT=0
ALERT_TEMPERATURE_C=0
ALERT_DISK_PERCENT=0
