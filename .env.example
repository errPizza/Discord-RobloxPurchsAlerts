# Runtime and persistent storage.  Docker maps these to /mnt on the Raspberry Pi.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=/app/data/database.sqlite
BACKUP_PATH=/app/backups
STATIC_ROOT=/app/data/web
STATIC_SOURCE_PATH=/app/frontend/dist
PUBLIC_ORIGIN=https://www.anothergamemore.online
COOKIE_SECURE=auto

# Generate long, unique values. Never commit the completed .env file.
SESSION_SECRET=
PASSWORD_PEPPER=
MOBILE_ACCESS_TOKEN_SECRET=
MOBILE_REFRESH_TOKEN_SECRET=

# Existing Roblox webhook secrets and Discord webhook URLs.
DONATION_SECRET=
ITEMS_SECRET=
STATS_SECRET=
BOMBGAME_SECRET=
DONATION_WEBHOOK=
SINGLE_ITEM_WEBHOOK=
BULK_ITEMS_WEBHOOK=
STATS_WEBHOOK=
REQUIRE_SIGNED_WEBHOOKS=true

# OAuth is optional. Leave both values of a provider blank to disable it.
GOOGLE_CLIENT_ID=711680251680-98ov3fbhqr0ds6q1i63iu8st6llioj4s.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
DISCORD_CLIENT_ID=1134931142282317936
DISCORD_CLIENT_SECRET=j0hDhhjKuebt6s6n8uv017nSU4ETsall

# Local services. Docker control stays disabled until the socket/proxy is mounted.
DOCKER_ENABLED=false
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_ALLOWED_CONTAINERS=
NGINX_ENABLED=false
HOST_CONTROL_ENABLED=false
HOST_CONTROL_SOCKET=/run/agm-host-control.sock
HOST_CONTROL_SECRET=

# Operations. Values below are documented defaults, not immutable requirements.
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_RETENTION=14
REQUEST_LOG_RETENTION_DAYS=30
ALERT_CPU_PERCENT=0
ALERT_RAM_PERCENT=0
ALERT_TEMPERATURE_C=0
ALERT_DISK_PERCENT=0
