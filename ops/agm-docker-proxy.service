[Unit]
Description=Another Game More restricted Docker API proxy
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=agmproxy
Group=agmapp
SupplementaryGroups=docker
ExecStart=/usr/bin/node /opt/another-game-more/ops/docker-proxy.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run

[Install]
WantedBy=multi-user.target
